{
  "name": "tauri-ssh-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:preview": "node scripts/preview-smoke.mjs",
    "check": "vue-tsc --noEmit",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:linux": "tauri build --bundles deb -- --locked",
    "desktop:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle -- --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
